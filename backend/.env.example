# 复制本文件为 .env 并填入你自己的 key（.env 已被 .gitignore 忽略，不会提交）

# ===== DeepSeek（慢模型：推理，用于最终预测）=====
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== 快模型（非思考，用于意图理解/抽取；留空则复用上面的 DeepSeek key）=====
FAST_MODEL=deepseek-chat
FAST_API_KEY=
FAST_BASE_URL=

# ===== Tavily 网页搜索（首发/伤病/最新动态）=====
TAVILY_API_KEY=your_tavily_api_key

# ===== football-data（免费，结构化数据主力 + 赛程/赛果）=====
FOOTBALL_DATA_API_KEY=your_football_data_token

# ===== api-football（免费层仅 2022-2024，未接入预测，留作历史层）=====
API_FOOTBALL_API_KEY=

# ===== The Odds API（赔率 / 赔率隐含概率 baseline）=====
THE_ODDS_API_KEY=your_the_odds_api_key

# ===== 以下均有默认值，按需覆盖 =====
# 日志
# LOG_DIR=D:/code/logs
# LOG_LEVEL=INFO
# RAG / 向量模型
# HF_HOME=D:/code/hf_cache
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CHROMA_PATH=D:/code/WC-agent/backend/data/chroma
# Redis（短期会话记忆）
# REDIS_URL=redis://localhost:6379/0
# MySQL（长期记忆 + 预测评估）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=wcpass
# MYSQL_DB=wc_agent
